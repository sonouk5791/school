[
  {
    "id": 0,
    "text": "안녕하세요! 콩이에요. 오늘도 저와 함께 천천히 몸을 움직여 볼까요? 편안하게 따라 해주세요.",
    "start": 0.2722222222222222,
    "end": 8.887777777777778,
    "duration": 8.615555555555556
  },
  {
    "id": 1,
    "text": "통증이나 어지러움이 느껴지면 운동을 멈추고 쉬어주세요.",
    "start": 9.184444444444445,
    "end": 13.444444444444446,
    "duration": 4.26
  },
  {
    "id": 2,
    "text": "필요한 경우 보호자 또는 직원과 함께 진행해주세요.",
    "start": 13.462222222222222,
    "end": 18.214444444444442,
    "duration": 4.752199546485261
  },
  {
    "id": 3,
    "text": "튼튼한 의자에 편안하게 앉아 주세요. 두 발은 바닥에 둡니다.",
    "start": 18.820000000000004,
    "end": 24.401111111111113,
    "duration": 5.5810884353741494
  },
  {
    "id": 4,
    "text": "두 손을 무릎 위에 올려볼게요.",
    "start": 24.555555555555557,
    "end": 26.914444444444445,
    "duration": 2.3588662131519276
  },
  {
    "id": 5,
    "text": "숨을 천천히 들이마시고.",
    "start": 27.068888888888893,
    "end": 29.24777777777778,
    "duration": 2.1788662131519274
  },
  {
    "id": 6,
    "text": "후, 편안하게 내쉬어요.",
    "start": 29.412222222222223,
    "end": 31.913333333333334,
    "duration": 2.5011337868480727
  },
  {
    "id": 7,
    "text": "어깨를 살짝 올려요.",
    "start": 32.21,
    "end": 34.11777777777778,
    "duration": 1.9078004535147393
  },
  {
    "id": 8,
    "text": "천천히 내려요.",
    "start": 34.24777777777778,
    "end": 35.8,
    "duration": 1.5521995464852607
  },
  {
    "id": 9,
    "text": "잘하고 계세요. 조금만 움직여도 좋아요.",
    "start": 36.050000000000004,
    "end": 39.75888888888889,
    "duration": 3.7088888888888887
  },
  {
    "id": 10,
    "text": "편안하게 쉬어주세요.",
    "start": 39.89,
    "end": 41.75,
    "duration": 1.86
  },
  {
    "id": 11,
    "text": "이번에는 토리와 함께 목과 어깨를 움직여요. 목은 작게 움직여요.",
    "start": 41.92777777777778,
    "end": 47.66444444444445,
    "duration": 5.736689342403628
  },
  {
    "id": 12,
    "text": "고개를 천천히 오른쪽으로.",
    "start": 47.81888888888889,
    "end": 50.22444444444445,
    "duration": 2.405578231292517
  },
  {
    "id": 13,
    "text": "다시 가운데.",
    "start": 50.52111111111112,
    "end": 52.00222222222222,
    "duration": 1.4811337868480725
  },
  {
    "id": 14,
    "text": "이번에는 왼쪽으로.",
    "start": 52.27444444444444,
    "end": 54.111111111111114,
    "duration": 1.8366893424036281
  },
  {
    "id": 15,
    "text": "어깨를 앞으로 작게 돌려요.",
    "start": 54.31333333333333,
    "end": 56.71888888888889,
    "duration": 2.405532879818594
  },
  {
    "id": 16,
    "text": "어깨를 뒤로 작게 돌려요.",
    "start": 56.96777777777778,
    "end": 59.20777777777778,
    "duration": 2.24
  },
  {
    "id": 17,
    "text": "아주 좋아요. 천천히 하시면 됩니다.",
    "start": 59.385555555555555,
    "end": 62.677777777777784,
    "duration": 3.2922448979591836
  },
  {
    "id": 18,
    "text": "이번에는 손과 팔을 움직여요. 두 손을 편하게 보여주세요.",
    "start": 62.817777777777785,
    "end": 67.87777777777778,
    "duration": 5.06
  },
  {
    "id": 19,
    "text": "손가락을 활짝 펴요.",
    "start": 68.08,
    "end": 70.17777777777778,
    "duration": 2.097777777777778
  },
  {
    "id": 20,
    "text": "살짝 쥐어요.",
    "start": 70.35555555555555,
    "end": 71.90777777777777,
    "duration": 1.5521995464852607
  },
  {
    "id": 21,
    "text": "손목을 작게 돌려요.",
    "start": 72.06222222222222,
    "end": 73.99333333333334,
    "duration": 1.931111111111111
  },
  {
    "id": 22,
    "text": "반대로 작게 돌려요.",
    "start": 74.14777777777779,
    "end": 76.00888888888889,
    "duration": 1.8611337868480726
  },
  {
    "id": 23,
    "text": "두 팔을 앞으로 쭉.",
    "start": 76.18666666666667,
    "end": 77.95222222222222,
    "duration": 1.765532879818594
  },
  {
    "id": 24,
    "text": "다시 편안하게.",
    "start": 78.08333333333333,
    "end": 79.53777777777778,
    "duration": 1.454467120181406
  },
  {
    "id": 25,
    "text": "정말 잘하셨어요. 손을 편안하게 내려요.",
    "start": 79.64222222222222,
    "end": 83.63555555555556,
    "duration": 3.993378684807256
  },
  {
    "id": 26,
    "text": "이번에는 나비와 상체를 움직여요. 팔은 편안한 높이까지만 올려요.",
    "start": 83.86111111111111,
    "end": 89.46666666666665,
    "duration": 5.605532879818594
  },
  {
    "id": 27,
    "text": "두 손을 앞으로 쭉.",
    "start": 89.69222222222223,
    "end": 91.24444444444444,
    "duration": 1.5522448979591836
  },
  {
    "id": 28,
    "text": "다시 가슴 앞으로.",
    "start": 91.35222222222222,
    "end": 92.83333333333333,
    "duration": 1.4811337868480725
  },
  {
    "id": 29,
    "text": "오른손을 편안한 높이로.",
    "start": 92.96333333333334,
    "end": 95.04888888888888,
    "duration": 2.085532879818594
  },
  {
    "id": 30,
    "text": "왼손을 편안한 높이로.",
    "start": 95.16666666666666,
    "end": 97.3111111111111,
    "duration": 2.1444444444444444
  },
  {
    "id": 31,
    "text": "옆으로 활짝.",
    "start": 97.58444444444444,
    "end": 99.13666666666666,
    "duration": 1.5521995464852607
  },
  {
    "id": 32,
    "text": "다시 모아요.",
    "start": 99.33888888888889,
    "end": 100.72444444444444,
    "duration": 1.3855782312925171
  },
  {
    "id": 33,
    "text": "아주 좋아요. 조금만 움직여도 좋아요.",
    "start": 100.99777777777778,
    "end": 104.99111111111111,
    "duration": 3.993333333333333
  },
  {
    "id": 34,
    "text": "보리와 다리를 움직여요. 앉은 채로 의자를 가볍게 잡아주세요.",
    "start": 105.31222222222222,
    "end": 110.73444444444443,
    "duration": 5.4222222222222225
  },
  {
    "id": 35,
    "text": "오른발 뒤꿈치를 살짝 들어요.",
    "start": 110.8711111111111,
    "end": 113.82222222222221,
    "duration": 2.951065759637188
  },
  {
    "id": 36,
    "text": "내리고, 왼발 뒤꿈치를 들어요.",
    "start": 114.19000000000001,
    "end": 117.16444444444444,
    "duration": 2.974467120181406
  },
  {
    "id": 37,
    "text": "뒤꿈치는 두고 발끝을 들어요.",
    "start": 117.50888888888889,
    "end": 120.31666666666666,
    "duration": 2.8077551020408165
  },
  {
    "id": 38,
    "text": "발끝을 천천히 내려요.",
    "start": 120.63777777777779,
    "end": 122.94777777777777,
    "duration": 2.3099773242630386
  },
  {
    "id": 39,
    "text": "가능한 분만 무릎을 조금 들어요. 힘드시면 발을 바닥에 두세요.",
    "start": 123.19777777777779,
    "end": 129.44555555555556,
    "duration": 6.247755102040816
  },
  {
    "id": 40,
    "text": "오른쪽 무릎을 조금만.",
    "start": 129.55666666666667,
    "end": 131.29777777777778,
    "duration": 1.7411337868480725
  },
  {
    "id": 41,
    "text": "내리고, 왼쪽을 조금만.",
    "start": 131.21555555555557,
    "end": 133.78666666666666,
    "duration": 2.571111111111111
  },
  {
    "id": 42,
    "text": "조금만 움직여도 아주 잘하고 계세요. 다리를 편히 쉬어요.",
    "start": 134.06,
    "end": 139.14444444444445,
    "duration": 5.084444444444444
  },
  {
    "id": 43,
    "text": "나비와 함께 가볍게 박수를 쳐볼까요?",
    "start": 139.37,
    "end": 142.6288888888889,
    "duration": 3.2589115646258504
  },
  {
    "id": 44,
    "text": "짝, 짝.",
    "start": 142.8777777777778,
    "end": 143.77888888888887,
    "duration": 0.9010884353741496
  },
  {
    "id": 45,
    "text": "오른쪽이면 오른손, 왼쪽이면 왼손이에요. 한 손씩 해볼게요.",
    "start": 143.89888888888888,
    "end": 150.0022222222222,
    "duration": 6.103310657596372
  },
  {
    "id": 46,
    "text": "오른쪽!",
    "start": 150.20444444444445,
    "end": 151.16444444444446,
    "duration": 0.96
  },
  {
    "id": 47,
    "text": "왼쪽!",
    "start": 151.29444444444445,
    "end": 152.11222222222221,
    "duration": 0.8177777777777778
  },
  {
    "id": 48,
    "text": "짝.",
    "start": 152.14777777777778,
    "end": 152.7522222222222,
    "duration": 0.6044444444444445
  },
  {
    "id": 49,
    "text": "잠시 기다려요.",
    "start": 152.81222222222223,
    "end": 154.31666666666666,
    "duration": 1.5044444444444445
  },
  {
    "id": 50,
    "text": "최고예요! 틀려도 괜찮아요. 함께 움직여서 즐거워요.",
    "start": 154.56555555555556,
    "end": 159.34222222222223,
    "duration": 4.776689342403628
  },
  {
    "id": 51,
    "text": "이번에는 모두 함께 해볼까요? 앉아서 천천히 따라 해요.",
    "start": 159.54333333333335,
    "end": 164.12555555555556,
    "duration": 4.582222222222223
  },
  {
    "id": 52,
    "text": "손 흔들고.",
    "start": 164.25666666666666,
    "end": 165.40555555555554,
    "duration": 1.1488888888888888
  },
  {
    "id": 53,
    "text": "두 손을 편안한 높이로.",
    "start": 165.48888888888888,
    "end": 168.08333333333331,
    "duration": 2.594421768707483
  },
  {
    "id": 54,
    "text": "최고!",
    "start": 168.85444444444445,
    "end": 169.79,
    "duration": 0.9355555555555556
  },
  {
    "id": 55,
    "text": "정말 잘하셨어요. 잠시 쉬어볼까요?",
    "start": 169.9922222222222,
    "end": 173.7488888888889,
    "duration": 3.7566893424036283
  },
  {
    "id": 56,
    "text": "이제 마지막이에요.",
    "start": 173.88,
    "end": 175.69222222222223,
    "duration": 1.8121995464852607
  },
  {
    "id": 57,
    "text": "오늘 정말 잘하셨어요. 조금이라도 몸을 움직이셨다면 성공이에요.",
    "start": 176.01333333333335,
    "end": 182.38888888888889,
    "duration": 6.375555555555556
  },
  {
    "id": 58,
    "text": "다음 시간에도 우리 함께 만나요. 안녕히 계세요!",
    "start": 182.63777777777779,
    "end": 186.79666666666668,
    "duration": 4.158866213151928
  }
]